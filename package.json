{
  "name": "interclasse",
  "version": "0.1.0",
  "private": true,
  "description": "Jogos Estudantis do CMEI Cosme Jean: turmas, inscrições, sorteio, placar e classificação",
  "license": "ISC",
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./shared --filter ./backend --filter ./frontend run dev",
    "dev:backend": "pnpm --parallel --filter \"{./backend}...\" run dev",
    "dev:frontend": "pnpm --parallel --filter \"{./frontend}...\" run dev",
    "build": "pnpm --filter ./shared run build",
    "check": "pnpm --filter ./shared run build && pnpm -r --filter ./shared --filter ./backend --filter ./frontend run typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7"
  }
}
