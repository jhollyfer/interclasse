# API
# Loaded by `vite build`, which runs with mode=production by default.
#
# This file is versioned, and the local `.env` is not - on purpose. The `VITE_`
# prefix embeds the value in the browser bundle, so nothing here is a secret by
# definition: it is the same URL anyone reads in the DevTools.
#
# And it is embedded at BUILD time, not read at runtime: changing the container
# variable changes nothing, changing the address requires rebuilding the image.
#
# This is the PUBLIC address, the one the visitor's browser reaches. It is the
# only one that works for download `href` and image `src`, because those become
# HTML the browser follows later.
#
# Nitro renders the first navigation on the server and is the one calling the
# API there. Forcing it to use this address makes the request leave for the
# internet and come back to reach a service that usually sits on the same
# network - in production that is most of the first navigation time.
# `SERVER_API_URL` below solves that.
#
# No trailing slash: `http.ts` does `BASE_URL.concat(path)` and the path already
# starts with `/`, so a slash here would become `//storefront` in the request.
VITE_API_URL=https://api-interclass.maiyu.com.br

# The API address seen from INSIDE the SSR server - the service name on the
# Docker network, typically. Read at runtime by Nitro, and not embedded in the
# bundle: without the `VITE_` prefix on purpose, so it never reaches the
# browser.
#
# Being a runtime value, it is set in the hosting panel (Coolify), not here -
# this file is read at build time. The line below only records that the
# variable exists and the expected format.
#
# Absent, the server uses the public address above and everything works as
# before.
# SERVER_API_URL=http://api:3333

# Site URL
# The PUBLIC site address: the base of canonical, hreflang and sitemap, which
# need an absolute URL. No trailing slash. Build time, like the one above.
VITE_SITE_URL=https://interclass.maiyu.com.br

# Storage
# The PUBLIC origin of the S3-compatible storage, for the CSP `connect-src` and
# `img-src` (`vite.config.ts`): the presigned upload does a PUT straight to it.
# No trailing slash. Build time, like the ones above. Absent, the CSP opens no
# storage origin and the upload fails in the browser - set it before deploy.
# VITE_STORAGE_URL=https://storage.example.com
