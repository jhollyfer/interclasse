# Construída a partir da RAIZ do workspace, como a do backend:
#   docker build -f frontend/Dockerfile-production .
# Imagem fixada por digest, atualizada pelo Dependabot (tooling.md §8.2, §9).
FROM node:24-alpine@sha256:8a32c8cf649a49915a66e81e7a609223c708d0adabf288ee3f4077d765542f85

WORKDIR /app

# curl para healthcheck
RUN apk add --no-cache curl

# Copia .output pronto (vem do artifact do build). O `.dockerignore` da raiz
# reabre só `frontend/.output`.
COPY frontend/.output/ ./.output/

# Usuario nao-root
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nitro && \
    chown -R nitro:nodejs /app/.output

USER nitro

# O `curl` instalado lá em cima existia sem consumidor. O orquestrador precisa
# saber se o Nitro subiu, e não só se o processo está de pé: um SSR que morreu
# no boot deixa o container vivo e a página em branco.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://127.0.0.1:3000/health-check || exit 1

EXPOSE 3000
ENV PORT=3000

CMD ["node", ".output/server/index.mjs"]
