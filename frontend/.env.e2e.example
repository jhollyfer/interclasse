# E2E
# Credentials and addresses for the E2E (`pnpm test:e2e`). Copy to `.env.e2e`
# (ignored by git) or export the variables. No default in the code on purpose:
# the E2E talks to the seeded database of whoever runs it, and the password is
# theirs.
#
# Organization account from the seed (`node ace db:seed` in the backend).
E2E_ADMIN_EMAIL=administrator@mail.com
E2E_ADMIN_PASSWORD=
# Advisor of a classroom with students.
E2E_ADVISOR_EMAIL=
E2E_ADVISOR_PASSWORD=
# Another advisor, of another classroom in the same category as the first.
E2E_SECOND_ADVISOR_EMAIL=
E2E_SECOND_ADVISOR_PASSWORD=
# API the app uses (the same `VITE_API_URL` as the webServer).
E2E_API_URL=http://localhost:3333
# Port of the app the `webServer` starts.
E2E_PORT=3010
# Optional: a chromium other than the `playwright install` one.
# E2E_CHROMIUM_PATH=
