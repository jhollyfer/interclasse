# E2E
# Credentials and addresses for the E2E (`pnpm test:e2e`). Copy to `.env.e2e`
# (ignored by git) or export the variables. Only keys of the house catalog
# (`_standards/backend.md` section 6.2), no default in the code on purpose: the
# E2E talks to the seeded database of whoever runs it, and the password is theirs.
E2E_BASE_URL=http://localhost:3010
E2E_API_URL=http://localhost:3333
# Administrator account from the seed (`node ace db:seed` in the backend).
E2E_OWNER_EMAIL=administrator@mail.com
E2E_OWNER_PASSWORD=
# The backend `SEED_DEMO_PASSWORD`: the advisors and the representative sign in
# with the demo accounts, whose e-mails come from the demo seeder.
E2E_DEMO_PASSWORD=
# Optional: a folder outside the repo for full-page captures; unset, it saves none.
# E2E_SHOTS_DIR=/tmp/shots
# Optional: a chromium other than the `playwright install` one.
# E2E_CHROMIUM_PATH=
