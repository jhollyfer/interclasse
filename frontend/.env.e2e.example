# Credenciais e endereços do E2E (`pnpm e2e`). Copie para `.env.e2e` (ignorado
# pelo git) ou exporte as variáveis. Sem default no código de propósito: o E2E
# fala com o banco semeado de quem roda, e a senha é dele.
#
# Conta de organização do seed (`node ace db:seed` no backend).
E2E_ADMIN_EMAIL=administrator@mail.com
E2E_ADMIN_PASSWORD=
# Conselheira de uma turma com alunos.
E2E_ADVISOR_EMAIL=
E2E_ADVISOR_PASSWORD=
# Outra conselheira, de outra turma da mesma categoria da primeira.
E2E_SECOND_ADVISOR_EMAIL=
E2E_SECOND_ADVISOR_PASSWORD=
# API que o app usa (o mesmo `VITE_API_URL` do webServer).
E2E_API_URL=http://localhost:3333
# Porta do app que o `webServer` sobe.
E2E_PORT=3010
# Opcional: chromium que não é o do `playwright install`.
# E2E_CHROMIUM_PATH=
