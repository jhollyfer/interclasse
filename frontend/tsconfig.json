{
  // Os tipos do servidor gerado pelo Nitro. Sem isto, `nitro/*` e as globais do
  // runtime não resolvem - passo documentado em `examples/vite-nitro-plugin`.
  "extends": "nitro/tsconfig",

  "include": [
    "**/*.ts",
    "**/*.tsx",
    "eslint.config.js",
    "prettier.config.js",
    "vite.config.js"
  ],

  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    // Um alias só, e é o que o campo `imports` do package.json declara. Com os
    // dois, cada arquivo escolhia um e o `@/` voltava sozinho toda vez que o
    // shadcn gerava um componente.
    "paths": {
      "#/*": ["./src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
