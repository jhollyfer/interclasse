{
  // The types of the server generated by Nitro. Without this, `nitro/*` and the runtime
  // globals do not resolve - a step documented in `examples/vite-nitro-plugin`.
  "extends": "nitro/tsconfig",

  "include": ["**/*.ts", "**/*.tsx", "eslint.config.js", "prettier.config.js"],

  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    // A single alias, and it is the one the package.json `imports` field declares. With
    // both, each file picked one and the `@/` came back on its own every time
    // shadcn generated a component.
    "paths": {
      "#/*": ["./src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUncheckedSideEffectImports": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  }
}
