# Base da API AdonisJS. Em dev é a porta que `backend/pnpm dev` sobe.
#
# O prefixo `VITE_` é o que faz o Vite embutir o valor no bundle do navegador -
# ou seja, publicá-lo. Nada de segredo entra neste arquivo: chave de API, senha
# e token de terceiro ficam no `.env` do backend, que não vai para o cliente.
VITE_API_URL=http://localhost:3333
