# Imagem de produção da API, construída a partir da RAIZ do workspace:
#   docker build -f backend/Dockerfile-production .
# Da raiz porque o backend depende do `@interclasse/shared` (workspace:*) e do
# lockfile único (_standards/tooling.md §1 e §8.2).
#
# Multi-stage, e o build acontece aqui dentro - não no runner de CI. A imagem é
# multi-arquitetura (amd64 e arm64) e o projeto tem dependência com binário
# nativo (`@swc/core`): um `node_modules` compilado no runner amd64 não roda na
# variante arm64. Compilando por estágio, cada arquitetura instala o binário
# dela.

# Imagem fixada por digest, atualizada pelo Dependabot (tooling.md §8.2, §9): tag
# móvel muda o que foi auditado sem commit.
FROM node:25-alpine@sha256:bdf2cca6fe3dabd014ea60163eca3f0f7015fbd5c7ee1b0e9ccb4ced6eb02ef4 AS builder

WORKDIR /repo

# Sem Corepack (_doc-lib/pnpm.md#installation): `npx get-pnpm` instala o binário
# nativo em PNPM_HOME e o pnpm troca sozinho para a versão de
# `devEngines.packageManager` no primeiro uso. Roda fora do projeto porque o npm
# recusa o `devEngines` do repositório (EBADDEVENGINES).
ENV PNPM_HOME=/pnpm \
    PNPM_NO_MODIFY_PATH=1
ENV PATH="$PNPM_HOME/bin:$PATH"
RUN cd /tmp && npx --yes get-pnpm

# Os manifestos antes do código: a camada de install só refaz quando muda
# dependência. O `pnpm-workspace.yaml` carrega o `allowBuilds`; sem ele o install
# decide sozinho o que compila, ou para.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY shared/package.json shared/
COPY backend/package.json backend/
COPY frontend/package.json frontend/
RUN pnpm --filter "{./backend}..." install --frozen-lockfile

COPY shared/ shared/
COPY backend/ backend/

# `node ace build` boota a aplicação (`bin/console.ts` importa `#start/env` no
# `app.booting`), então a validação de `start/env.ts` roda durante o build.
# Estes valores existem só para satisfazer o schema: nenhum sobrevive ao
# estágio, e em produção quem injeta as variáveis reais é a plataforma.
ENV NODE_ENV=development \
    PORT=3333 \
    HOST=0.0.0.0 \
    LOG_LEVEL=info \
    APP_SERVER_URL=http://localhost:3333 \
    DATABASE_URL=postgres://build:build@localhost:5432/build \
    UPLOAD_MAX_SIZE=209715200 \
    STORAGE_KEY=build \
    STORAGE_SECRET=build \
    STORAGE_BUCKET=build \
    STORAGE_ENDPOINT=http://localhost:9000

# O `shared/` compila antes do app (ordem topológica do filtro, `build` do
# backend é `node ace build`). APP_KEY fica na linha do comando, e não em ENV:
# em ENV ela viraria metadado da imagem.
RUN APP_KEY=build-time-placeholder-nao-usada-em-runtime \
    pnpm --filter "{./backend}..." run build

# Só o app e o `dist/` do `shared/`, sem dev tool (_doc-lib/pnpm.md#cli/deploy).
# `files: ["build"]` no package.json do backend faz o deploy levar só a saída
# do `node ace build`.
RUN pnpm --filter ./backend --prod deploy /out


FROM node:25-alpine@sha256:bdf2cca6fe3dabd014ea60163eca3f0f7015fbd5c7ee1b0e9ccb4ced6eb02ef4

WORKDIR /app

RUN apk add --no-cache curl

# A saída do `node ace build` na raiz de /app e o `node_modules` do deploy ao
# lado: o mesmo layout da imagem anterior, então o comando de deploy da
# plataforma (`node ace migration:run --force`) e o CMD não mudam.
COPY --from=builder --chown=node:node /out/build ./
COPY --from=builder --chown=node:node /out/node_modules ./node_modules

# A imagem `node` já traz o usuário `node` (uid 1000). Não há diretório de
# upload para ajustar permissão: todo arquivo vai para o bucket S3-compatível.
USER node

EXPOSE 3333

ENV NODE_ENV=production \
    PORT=3333 \
    HOST=0.0.0.0

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:3333/health-check || exit 1

# Sem ENTRYPOINT: migration não roda no start do container. Quem migra é o
# comando de deploy da plataforma, o Post-deployment command do Coolify
# (`node ace migration:run --force`), para que subir uma réplica não seja o
# mesmo evento que alterar o schema.
CMD ["node", "bin/server.js"]
