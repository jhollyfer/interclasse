# Database
# A database SEPARATE from the development one: the suite runs `truncate()`
# between tests, and without this line it would wipe the development data.
# Create it once with:
#   docker compose exec database createdb -U interclasse interclasse_test
DATABASE_URL=postgres://interclasse:interclasse@localhost:5434/interclasse_test

# Storage
# Presigned multipart upload: the suite talks to the docker-compose MinIO, the
# same code path as production. Bucket SEPARATE from the development one, for
# the same reason as DATABASE_URL above - the seed names are fixed, and a test
# would overwrite the binary `pnpm dev` is serving. The bucket is created by the
# `minio-setup` service.
#
# The ceiling is 16 GiB here, deliberately above the dev one: the suite must
# declare sizes the development ceiling would refuse. Nothing is transferred -
# the test binary is a few KB, and the large size travels only as metadata.
UPLOAD_MAX_SIZE=17179869184

STORAGE_KEY=interclasse
STORAGE_SECRET=interclasse-secret
STORAGE_BUCKET=interclasse-test
STORAGE_ENDPOINT=http://localhost:9004
STORAGE_FORCE_PATH_STYLE=true

# CORS
# The CORS allowlist. `NODE_ENV=test` is not development, so `config/cors.ts`
# applies the list instead of allowing everything - that is exactly the path
# `tests/functional/cors.spec.ts` exercises.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Seeding
# The suite runs `db().seed()` on every test, and the seeder refuses an absent
# password.
SEED_ADMINISTRATOR_PASSWORD=Administrator1!
