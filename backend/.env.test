SESSION_DRIVER=memory

# Banco SEPARADO do de desenvolvimento: a suíte roda `truncate()` entre os
# testes, e sem esta linha ela apagaria os dados do banco de desenvolvimento.
# Crie uma vez com:
#   docker compose exec database createdb -U interclasse interclasse_test
DATABASE_URL=postgres://interclasse:interclasse@localhost:5434/interclasse_test

# Upload presigned multipart: a suíte fala com o MinIO do docker-compose, o
# mesmo caminho de código de produção. Bucket SEPARADO do de desenvolvimento,
# pelo mesmo motivo do DATABASE_URL acima - os nomes do seed são fixos, e um
# teste sobrescreveria o binário que o `pnpm dev` está servindo. O bucket é
# criado pelo serviço `storage-bootstrap`.
#
# O teto é 16 GiB aqui, deliberadamente acima do de dev: a suíte precisa
# declarar tamanhos que o teto de desenvolvimento recusaria. Nada é
# transferido - o binário do teste tem alguns KB, e o tamanho grande viaja só
# como metadado.
UPLOAD_MAX_SIZE=17179869184

STORAGE_KEY=interclasse
STORAGE_SECRET=interclasse-secret
STORAGE_BUCKET=interclasse-test
STORAGE_ENDPOINT=http://localhost:9004
STORAGE_FORCE_PATH_STYLE=true

# A allowlist do CORS. `NODE_ENV=test` não é desenvolvimento, então
# `config/cors.ts` aplica a lista em vez de liberar tudo - é justamente esse o
# caminho que `tests/functional/cors.spec.ts` exercita.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# A suíte roda `db().seed()` a cada teste, e o seeder recusa senha ausente.
SEED_OWNER_PASSWORD=Administrator1!
