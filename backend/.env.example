# Node
# Process time zone. `UTC` in every environment: when absent, Node inherits the
# host zone and the same query answers different dates depending on the machine.
# Converting to the reader's zone is the presentation layer's job.
TZ=UTC
PORT=3333
# In a container use `0.0.0.0`: `localhost` only accepts connections from inside
# the container itself, and the host proxy never gets through.
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_SERVER_URL=http://${HOST}:${PORT}
# Trusted reverse proxy, so the per-IP limit sees the client and not the proxy.
# A single value (IP, subnet or `loopback`/`linklocal`/`uniquelocal`). Absent
# means `loopback`. Behind the Coolify Traefik, the Docker network subnet;
# never `true`.
# TRUSTED_PROXIES=172.16.0.0/12

# CORS
# Browser origins allowed to call this API, comma separated. It is both the CORS
# allowlist and the origin barrier (CSRF): every write whose `Origin` is not
# listed gets 403, in development too. Required in production (boot stops
# without it). `*` is not an option: the API uses cookies, and the protocol
# refuses a wildcard when the request carries credentials.
CORS_ORIGINS=http://localhost:3001
# In production: CORS_ORIGINS=https://interclass.maiyu.com.br

# The `Domain` of the session cookies. Empty in development, which is right:
# cookies ignore the port, so `localhost:3333` and `localhost:3001` already share
# the same domain.
#
# In production they do not. Without this line the cookie is born host-only on
# the API host, and the frontend SSR - which calls the API on the first
# navigation - never receives it: every F5 on a private route goes back to the
# sign-in screen.
#
# In production it is **required**, and the schema does not enforce it:
# `start/env.ts` declares it optional because empty is the right value in
# development.
#
# The value is the smallest domain that covers both hosts.
# COOKIE_DOMAIN=.maiyu.com.br

# Database
# 5434 and not 5432: other projects on the same machine already use the
# previous ports.
DATABASE_URL=postgres://interclasse:interclasse@localhost:5434/interclasse
# TLS on the connection. It depends on where the database is, not on the
# environment: a database on the application's private network usually does not
# speak TLS (leave it absent or `false`); a managed database usually requires it
# (`true`).
# DATABASE_SSL=false

# Storage
# Upload is presigned multipart: the binary goes from the browser straight to
# the bucket and never crosses this application. Multipart is an S3 API, so the
# target is an S3-compatible bucket in every environment - MinIO in dev and in
# tests, and in production whatever STORAGE_ENDPOINT points to.
#
# Per-file ceiling, in bytes. Required: the application does not start without
# it. How much fits in one upload is the operator's decision, and a default in
# the code would be a ceiling nobody chose. Below, 1 GiB.
UPLOAD_MAX_SIZE=1073741824

# Local MinIO (docker compose up -d). Console at http://localhost:9005.
# Ports shifted for the same reason as the database above.
STORAGE_KEY=interclasse
STORAGE_SECRET=interclasse-secret
STORAGE_BUCKET=interclasse
STORAGE_ENDPOINT=http://localhost:9004
# MinIO only serves `endpoint/bucket/key`. In production (R2, S3, Spaces), remove.
STORAGE_FORCE_PATH_STYLE=true

# In production:
# STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com  (or s3.<region>.amazonaws.com, etc.)
#
# The bucket is **private**: nothing in it is served by a public URL, and every
# read goes through a short-lived signed URL. The production bucket needs CORS
# open to the frontend origin, with PUT in the methods and `ETag` in
# ExposeHeaders - without the exposed ETag the client cannot confirm the parts
# and no multipart upload completes.
#
# The policy is not applied by deploy: set it in the provider panel (in R2,
# bucket > Settings > CORS) or with `aws s3api put-bucket-cors`.

# Seeding
# The password of the administrator that `node ace db:seed` creates. Without it
# the seeder stops, on purpose: the password used to be a literal in the code and
# the repository is the wrong place for a credential - anyone who read the
# seeder signed in as owner of every already seeded environment, production
# included.
#
# The application starts without these: the one that requires them is the
# seeder, which runs by hand.
SEED_ADMINISTRATOR_EMAIL=administrator@mail.com
SEED_ADMINISTRATOR_PASSWORD=

# The password of the demo accounts (`database/seeders/dev/demo.ts`, run by
# `pnpm db:seed:demo`). Absent, the seeder skips the demo.
# SEED_DEMO_PASSWORD=
